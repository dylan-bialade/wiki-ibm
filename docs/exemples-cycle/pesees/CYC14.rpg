     I                                              TRNSECL2
     I                                              TRNCODL1M1
     IPESEER      02
     I                                              PSSEC L2
     I                                              PSTRN L1M1
      * Nouveau groupe tournee
     C   L1                SETOF                     505152
      * Enregistrement TOURNEE
     C   01                SETON                     50
     C   01                MOVE TRNCOD    CODT    4
     C   01                MOVE TRNSEC    SECW    2
     C   01NMR             SETON                     52
      * Enregistrement PESEE
     C   02                MOVE PSTRN     CODT
     C   02                MOVE PSSEC     SECW
     C   02                MOVE PSCAM     CAMW    9
     C   02NMR             SETON                     51
      * Nouveau secteur : referentiel
     C   L2      SECW      CHAINSECTEUR              90
     C   L2 90             MOVEL'Inconnu' SECNOM    P
     C   L2 90             Z-ADD0         SECPOP
      * Poids net de la pesee
     C   02      PSBRU     SUB  PSTAR     NET     60
      * Referentiel des flux : rang IX (6 = hors referentiel)
     C   02                Z-ADD1         X       20
     C   02      PSFLX     LOKUPFLX,X                    40
     C   02N40             Z-ADD6         X
      * Cout de traitement : net (kg) x cout a la tonne / 1000
     C   02      NET       MULT COU,X     WCOUT  112
     C   02      WCOUT     DIV  1000      COUT    72H
     C   02                MOVELPSDAT     MOIS    60
     C   02      1         ADD  NBP1      NBP1    50
     C   02      NET       ADD  REA1      REA1    90
     C   02      COUT      ADD  COU1      COU1   112
     C   02      1         ADD  NBF,X     NBF,X
     C   02      NET       ADD  TONF,X    TONF,X
     C   02      COUT      ADD  COUF,X    COUF,X
      * Temps total tournee : prevu / realise / ecart
     CL1                   Z-ADD0         PRV1    70
     CL1 50                Z-ADDTRNPRV    PRV1
     CL1         REA1      SUB  PRV1      ECA1    70
     CL1                   Z-ADD0         PCT1    51
     CL1                   SETOF                     5354
     CL1         PRV1      COMP 0                    55
     CL1 55      ECA1      MULT 100       W      110
     CL1 55      W         DIV  PRV1      PCT1      H
     CL1 55      PCT1      COMP 10                   53
     CL1 55      PCT1      COMP -10                    54
     CL1         PRV1      ADD  PRV2      PRV2    90
     CL1         REA1      ADD  REA2      REA2    90
     CL1         NBP1      ADD  NBP2      NBP2    50
     CL1 52      1         ADD  NBNC      NBNC    30
     CL1 51      NBP1      ADD  NBOR      NBOR    30
     CL1         COU1      ADD  COU2      COU2   112
      * Bilan de la tournee dans BILTRN
     CL1                   Z-ADDMOIS      BTMOIS
     CL1                   MOVE CODT      BTTRN
     CL1                   MOVE SECW      BTSEC
     CL1                   MOVE *BLANK    BTFLX
     CL1 50                MOVE TRNFLX    BTFLX
     CL1                   Z-ADDNBP1      BTNBP
     CL1                   Z-ADDPRV1      BTPRV
     CL1                   Z-ADDREA1      BTREA
     CL1                   Z-ADDECA1      BTECA
     CL1                   Z-ADDCOU1      BTCOU
     CL1                   MOVE ' '       BTSTA
     CL1 52                MOVE 'N'       BTSTA
     CL1 51                MOVE 'I'       BTSTA
     CL1                   WRITEBILTRNR
      * Lignes de total de la tournee (sorties d'exception)
