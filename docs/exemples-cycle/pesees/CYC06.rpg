      * CYC06 - Sous-totaux par tournee
     H            D/J
     FPESEE   IP  E           K        DISK
     FQSYSPRT O   F     132     OF     PRINTER
     IPESEER      01
     I                                              PSTRN L1
     I                                              PSTAR           21
      * Poids net de la pesee
     C   01      PSBRU     SUB  PSTAR     NET     60
      * Date AAAAMMJJ -> JJMMAAAA
     C   01                MOVE PSDAT     WMMJJ   40
     C   01                MOVELPSDAT     WAAAA   40
     C   01                MOVE WMMJJ     WJJ     20
     C   01                MOVELWMMJJ     WMM     20
     C   01      WJJ       MULT 1000000   DATJMA  80
     C   01      WMM       MULT 10000     W8      80
     C   01                ADD  W8        DATJMA
     C   01                ADD  WAAAA     DATJMA
      * Anomalies : 22 surcharge, 23 refus eleve, 24 au moins une
     C   01      NET       COMP 19000                22
     C   01      PSREF     COMP 25                   23
     C                     SETOF                     24
     C   01 21             SETON                     24
     C   01 22             SETON                     24
     C   01 23             SETON                     24
      * Cumuls generaux
     C   01      1         ADD  NBPG      NBPG    50
     C   01      PSBRU     ADD  BRUG      BRUG    90
     C   01      PSTAR     ADD  TARG      TARG    90
     C   01      NET       ADD  NETG      NETG    90
     C   01 24   1         ADD  NBAG      NBAG    50
     C   01      1         ADD  NBP1      NBP1    50
     C   01      NET       ADD  NET1      NET1    90
      * Temps total : fin de fichier
     CLR         NETG      DIV  NBPG      MOYG    70H
     OQSYSPRT H  101   1P
     O       OR        OF
     O                                   24 'SYNDICAT DE COLLECTE SUD'
     O                                   72 'PESÉES PAR TOURNÉE'
     O                                  109 'Édité le'
     O                         UDATE Y  118
     O                                  125 'Page'
     O                         PAGE  Z  130
     OQSYSPRT H  2     1P
     O       OR        OF
     O                                   23 'Pont-bascule de site A1'
     OQSYSPRT H  2     1P
     O       OR        OF
     O                                    6 'Ticket'
     O                                   15 'Tournée'
     O                                   26 'Date'
     O                                   33 'Heure'
     O                                   45 'Camion'
     O                                   51 'Flux'
     O                                   61 'Brut kg'
     O                                   71 'Tare kg'
     O                                   81 'Net kg'
     OQSYSPRT D  1     01
     O                         PSTKT      6
     O                         PSTRN     13
     O                         DATJMA    26 '0  /  /    '
     O                         PSHEU     33 '  :  '
     O                         PSCAM     45
     O                         PSFLX     50
     O                         PSBRU 3   61
     O                         PSTAR 3   71
     O                         NET   3   81
     OQSYSPRT T  2     L1
     O                                   19 'Total tournée'
     O                         PSTRN     24
     O                         NBP1  3B  40
     O                                   47 'pesées'
     O                         NET1  3B  81
     OQSYSPRT T 11     LR
     O                                   24 'TOTAL GÉNÉRAL'
     O                         NBPG  3   40
     O                                   47 'pesées'
     O                         BRUG  3   61
     O                         TARG  3   71
     O                         NETG  3   81
     OQSYSPRT T  1     LR
     O                                   36 'Net moyen par pesée'
     O                         MOYG  3   81
     O                                   84 'kg'
     OQSYSPRT T  1     LR
     O                                   29 'Pesées en anomalie'
     O                         NBAG  3   81
