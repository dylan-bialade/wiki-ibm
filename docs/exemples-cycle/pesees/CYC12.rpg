      * CYC12 - Prevu / realise par tournee (deux fichiers synchronises)
      * 50 connue 51 sans tournee 52 sans pesee 53/54 ecart hors +/-10 %
     H            D/J
     FTOURNEE IP  E           K        DISK
     FPESEE   IS  E           K        DISK
     FQSYSPRT O   F     132     OF     PRINTER
     ITOURNEER    01
     I                                              TRNSECL2
     I                                              TRNCODL1M1
     IPESEER      02
     I                                              PSSEC L2
     I                                              PSTRN L1M1
      * Nouveau groupe tournee
     C   L1                SETOF                     505152
      * Enregistrement TOURNEE
     C   01                SETON                     50
     C   01                MOVE TRNCOD    CODT    4
     C   01                MOVE TRNSEC    SECW    2
     C   01NMR             SETON                     52
      * Enregistrement PESEE
     C   02                MOVE PSTRN     CODT
     C   02                MOVE PSSEC     SECW
     C   02                MOVE PSCAM     CAMW    9
     C   02NMR             SETON                     51
      * Poids net de la pesee
     C   02      PSBRU     SUB  PSTAR     NET     60
     C   02      1         ADD  NBP1      NBP1    50
     C   02      NET       ADD  REA1      REA1    90
      * Temps total tournee : prevu / realise / ecart
     CL1                   Z-ADD0         PRV1    70
     CL1 50                Z-ADDTRNPRV    PRV1
     CL1         REA1      SUB  PRV1      ECA1    70
     CL1                   Z-ADD0         PCT1    51
     CL1                   SETOF                     5354
     CL1         PRV1      COMP 0                    55
     CL1 55      ECA1      MULT 100       W      110
     CL1 55      W         DIV  PRV1      PCT1      H
     CL1 55      PCT1      COMP 10                   53
     CL1 55      PCT1      COMP -10                    54
     CL1         PRV1      ADD  PRV2      PRV2    90
     CL1         REA1      ADD  REA2      REA2    90
     CL1         NBP1      ADD  NBP2      NBP2    50
     CL1 52      1         ADD  NBNC      NBNC    30
     CL1 51      NBP1      ADD  NBOR      NBOR    30
      * Temps total secteur
     CL2         REA2      SUB  PRV2      ECA2    90
     CL2         ECA2      MULT 100       W
     CL2         W         DIV  PRV2      PCT2    51H
     CL2         PRV2      ADD  PRVG      PRVG    90
     CL2         REA2      ADD  REAG      REAG    90
     CL2         NBP2      ADD  NBPG      NBPG    50
      * Fin de fichier
     CLR         REAG      SUB  PRVG      ECAG    90
     CLR         ECAG      MULT 100       W
     CLR         W         DIV  PRVG      PCTG    51H
     OQSYSPRT H  101   1P
     O       OR        OF
     O                                   24 'SYNDICAT DE COLLECTE SUD'
     O                                   72 'PRÉVU / RÉALISÉ'
     O                                  109 'Édité le'
     O                         UDATE Y  118
     O                                  125 'Page'
     O                         PAGE  Z  130
     OQSYSPRT H  2     1P
     O       OR        OF
     O                                   23 'Pont-bascule de site A1'
     OQSYSPRT H  2     1P
     O       OR        OF
     O                                    7 'Tournée'
     O                                   12 'Flux'
     O                                   24 'Jours'
     O                                   36 'Chauffeur'
     O                                   61 'Prévu kg'
     O                                   73 'Réalisé kg'
     O                                   81 'Pesées'
     O                                   93 'Écart kg'
     O                                  102 'Écart %'
     O                                  118 'Observation'
     OQSYSPRT T  1     L1
     O                         CODT       6
     O                 50      TRNFLX    11
     O                 50      TRNJOU    24
     O                 50      TRNCHF    45
     O                 51      CAMW      45
     O                         PRV1  3   61
     O                         REA1  3B  73
     O                         NBP1  3B  81
     O                         ECA1  L   93
     O                 55      PCT1  L  102
     O                 52               118 'NON COLLECTÉE'
     O                 51               121 'TOURNÉE INCONNUE'
     O                 53N51N52         120 'ÉCART > +10 %'
     O                 54N51N52         120 'ÉCART < -10 %'
     OQSYSPRT T 12     L2
     O                                   15 'TOTAL SECTEUR'
     O                         SECW      18
     O                         PRV2  3B  61
     O                         REA2  3B  73
     O                         NBP2  3B  81
     O                         ECA2  L   93
     O                         PCT2  L  102
     OQSYSPRT T  1     LR
     O                                   15 'TOTAL GÉNÉRAL'
     O                         PRVG  3   61
     O                         REAG  3   73
     O                         NBPG  3   81
     O                         ECAG  L   93
     O                         PCTG  L  102
     OQSYSPRT T 11     LR
     O                                   30 'Tournées non collectées'
     O                         NBNC  3   36
     OQSYSPRT T  1     LR
     O                                   30 'Pesées sans tournée'
     O                         NBOR  3   36
